# Postgres connection. Locally any Postgres 15+ works; in production use the
# Supabase project's connection string (Settings > Database).
DATABASE_URL=postgres://lorry:lorry@localhost:5432/lorry

# Long random string used to hash one-time sign-in codes.
AUTH_SECRET=change-me-to-a-long-random-string

# When true, the sign-in code is shown on screen instead of sent by SMS.
# Never set this in production.
OTP_DEV_MODE=true
